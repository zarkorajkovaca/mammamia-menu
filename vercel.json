{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(data|includes|references|tests)(/.*)?",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/menu/?",
      "dest": "/menu.php"
    },
    {
      "src": "/qr/?",
      "dest": "/qr.php"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}